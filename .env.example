# Variables de entorno del cliente de escritorio de Easy HUD.
# En desarrollo (`npm start`) se lee un `.env` en la raíz del proyecto; lo que
# ya esté en el entorno manda. El programa instalado sólo lee el entorno real.

# Clave de HenrikDev para el respaldo de rangos por puuid. Sin clave, el
# respaldo no se usa (sólo la API local del cliente de Riot). NO hay clave
# embebida en el binario.
HDEV_KEY=

# Carpeta de datos del observador (localStorage del panel + storage/*.json).
# Vacía = la que elige el programa (ver README, "Carpeta de datos").
# El perfil jugador ignora esto: siempre usa %APPDATA%\spectra-client-player.
EASY_DIR_DATOS=

# Puerto del servidor local del overlay (OBS). Por defecto 5310.
EASY_PUERTO_LOCAL=

# SÓLO desarrollo (con --development): URL de ingesta alternativa, p. ej. un
# servidor-v2 local. Debe acabar en :5100 para que la salida se derive a :5200.
EASY_INGEST=

# Origen del overlay para montar el renderer (relativo a este proyecto).
# Por defecto ../overlay.
EASY_OVERLAY=
